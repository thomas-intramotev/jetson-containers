# subprojects/pygobject.wrap
#
# Place this file at subprojects/pygobject.wrap in the combined project.
# meson will shallow-clone the named revision into subprojects/pygobject/
# on first `meson setup` (or you can pre-populate it with
# `meson subprojects download`).
#
# Why pin to 3.50.2:
#   pygobject 3.50.x is the last series that builds against
#   libgirepository-1.0.  3.51+ requires libgirepository-2.0, which is
#   not packaged on older LTS distros (e.g. Ubuntu 22.04).  3.50.2 is
#   the latest release in the 3.50 line at the time of writing.

[wrap-git]
url = https://gitlab.gnome.org/GNOME/pygobject.git
revision = _PYGOBJECT_VERSION_
depth = 1

# The [provide] section tells meson that this subproject satisfies the
# `pygobject-3.0` pkg-config dependency by exposing the meson variable
# `pygobject_dep` (declared near the bottom of pygobject's meson.build
# as `pygobject_dep = declare_dependency(...)`).
#
# This is what makes gst-python's
#   dependency('pygobject-3.0', fallback: ['pygobject', 'pygobject_dep'])
# resolve to the in-tree pygobject build without needing
# pygobject-3.0.pc on the system.
[provide]
pygobject-3.0 = pygobject_dep
